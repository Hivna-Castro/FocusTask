<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
   <%= stylesheet_link_tag 'main.css' %>
</head>

<body class="bg-light" style="min-height: 100vh;">
  <div class="container-fluid">
    <div class="row align-items-center mb-4 position-fixed top-0 w-100 bg-light shadow-sm p-3" style="z-index: 1030;">
      <div class="col-md-6">
        <h2 class="fw-bold text-primary">FocusTask</h2>
      </div>
      <div class="col-md-6 text-end">
        <%= link_to 'Sair', logout_path, data: { confirm: "Tem certeza que quer sair?" }, class: 'btn btn-outline-secondary me-2' %>
        <%= link_to 'Adicionar Tarefa', new_task_path, class: 'btn btn-primary' %>
      </div>
    </div>

    <div style="height: 100px;"></div>

    <div class="row mt-4 justify-content-center">
      <% if @tasks.any? %>
        <% @tasks.each do |task| %>
          <div class="col-12 col-sm-6 col-lg-4 mb-4 d-flex align-items-stretch">
            <div class="card shadow-sm w-100 task-card" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#taskModal_<%= task.id %>">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= task.title %></h5>
                <p class="card-text text-truncate" style="max-height: 3.5em;"><%= task.description %></p>

                <div class="mt-auto mb-2">
                  <% priority_class = case task.priority %>
                    <% when 'urgent' then 'bg-danger text-white' %>
                    <% when 'high' then 'bg-warning text-dark' %>
                    <% when 'medium' then 'bg-warning text-dark' %>
                    <% when 'low' then 'bg-success text-white' %>
                  <% end %>
                  <span class="badge <%= priority_class %>"><%= task.priority.capitalize %></span>

                  <% status_class = case task.status %>
                    <% when 'pending' then 'bg-maroon text-white' %>
                    <% when 'in_progress' then 'bg-info text-dark' %>
                    <% when 'completed' then 'bg-primary text-white' %>
                  <% end %>
                  <span class="badge <%= status_class %>"><%= task.status.capitalize %></span>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="taskModal_<%= task.id %>" tabindex="-1" aria-labelledby="taskModalLabel_<%= task.id %>" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="taskModalLabel_<%= task.id %>"><%= task.title %></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p><%= task.description %></p>
                </div>
                <div class="modal-footer">
                  <%= link_to 'Editar', edit_task_path(task), class: 'btn btn-primary' %>
                  <%= form_with url: task_path(task), method: :delete, data: { confirm: "Tem certeza?" }, class: 'd-inline' do |form| %>
                    <%= form.submit 'Excluir', class: 'btn btn-danger' %>
                  <% end %>
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-muted">Nenhuma tarefa encontrada.</p>
      <% end %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
