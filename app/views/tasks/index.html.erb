<h1>Tarefas</h1>

<% if @tasks.any? %>
  <ul>
    <% @tasks.each do |task| %>
      <li><%= task.title %></li>
    <% end %>
  </ul>
<% else %>
  <p>Nenhuma tarefa encontrada.</p>
<% end %>

<%= link_to 'Adicionar Tarefa', new_task_path, class: 'btn btn-primary' %>

<%= link_to 'Sair', logout_path, data: { confirm: "Tem certeza que quer sair?" } %>
