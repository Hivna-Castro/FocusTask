<body class="bg-gray-100">
  <!-- Barra Superior -->
  <header class="bg-primary shadow-md fixed top-0 w-full z-10 px-4 rounded-md " >
    <div class="flex items-center py-6 w-full">
      <div class="mt-4 ml-10">
        <h1 class="text-2xl font-bold text-white ml-10">FocusTask</h1>`
      </div>
      
      <div style="margin-right: 0px; margin-left: auto;">
        <%= link_to logout_path, class: 'text-white font-semibold rounded-md ' do %>
          <span class="material-icons mr-0">logout</span> 
        <% end %>
      </div>
    </div>

  </header>

  <!-- Conteúdo Principal -->
  <main class=" mt-2 mb-4" >
    <div class="flex items-center py-4 w-full">
      <div class="mx-auto ">
      <%= link_to 'Tarefas', tasks_path, class: 'px-4 py-2 bg-primary text-white font-medium rounded-md hover:bg-blue-800' %>
      <%= link_to 'Categorias', categories_path, class: 'px-4 py-2 text-primary font-medium rounded-md hover:bg-blue-800' %>
      </div>
      <div class=" mx-0"> 
        <%= link_to new_task_path, class: 'flex items-center px-4 py-2 text-primary font-semibold rounded-md hover:bg-primary-hover' do %>
          <span class="material-icons ">add</span> 
        <% end %>
      </div>
    </div>


    <% if @tasks.any? %>
      <div class=" grid grid-cols-3 grid-rows-2  gap-6 mt-2 mx-4">
        <% @tasks.each do |task| %>
          <div class="bg-white borderv  border-gray-200 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
            <div class="flex justify-evenly items-center mb-4">
              <div>
                <h3 class="text-lg font-bold text-gray-800 truncate"><%= task.title %></h3>
              </div>
              <div style= "margin-left: auto">
                <span class="text-sm text-gray-500"><%= task.due_date %></span>
              </div>
            </div>

            <!-- Descrição -->
            <p class="text-sm text-gray-600 mb-4 line-clamp-3">
              <%= task.description %>
            </p>

            <!-- Tags -->
            <div class="flex gap-2 flex-wrap mt-2">
              <% priority_class = case task.priority %>
                <% when 'urgent' then 'bg-red-100 text-red-600' %>
                <% when 'high' then 'bg-orange-100 text-orange-600' %>
                <% when 'medium' then 'bg-yellow-100 text-yellow-600' %>
                <% when 'low' then 'bg-green-100 text-green-600' %>
              <% end %>
              <div class="px-3 py-1 rounded-full text-xs font-semibold <%= priority_class %>">
                <%= task.priority.capitalize %>
              </div>

              <% status_class = case task.status %>
                <% when 'pending' then 'bg-blue-100 text-blue-600' %>
                <% when 'in_progress' then 'bg-purple-100 text-purple-600' %>
                <% when 'completed' then 'bg-green-100 text-green-600' %>
              <% end %>
              <span class="px-3 py-1 rounded-full text-xs font-semibold <%= status_class %>">
                <%= task.status.capitalize %>
              </span>

              <% if task.category %>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-pink-100 text-pink-600">
                  <%= task.category.name.capitalize %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-gray-500 text-lg mt-8">Nenhuma tarefa encontrada.</p>
    <% end %>
  </main>
</body>