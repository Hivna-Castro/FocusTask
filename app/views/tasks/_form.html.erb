<%= form_with model: @task, local: true do |form| %>
  <div class="mb-3">
    <%= form.label :titulo %>
    <%= form.text_field :titulo, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :descrição %>
    <%= form.text_area :descrição, class: "form-control" %>
  </div>

  <%= form.submit "Adicionar Tarefa", class: "btn btn-primary" %>
<% end %>

