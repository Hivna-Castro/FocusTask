<%= stylesheet_link_tag 'main.css' %>
  
 <body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 bg-white shadow rounded d-flex overflow-hidden">
          
          <div class="col-md-6 d-flex flex-column justify-content-center align-items-start p-5 text-white bg-primary">
            <h2 class="fw-bold">FocusTask</h2>
            <p class="lead">Gerenciando suas tarefas com eficiência.</p>
          </div>

          <div class="col-md-6 p-5">
            <h1 class="h4 mb-4 fw-normal text-center">Cadastro</h1>
            <%= form_with(url: signup_path, local: true, class: "mt-3") do |form| %>
              <div class="mb-3">
                <%= form.label :name, "Name", class: "form-label" %>
                <%= form.text_field :name, class: "form-control", placeholder: "Insira seu nome", required: true, name: "user[name]" %>
              </div>
              
              <div class="mb-3">
                <%= form.label :email, "Email", class: "form-label" %>
                <%= form.email_field :email, class: "form-control", placeholder: "Insira seu email", required: true, name: "user[email]" %>
              </div>
              
              <div class="mb-3">
                <%= form.label :password, "Senha", class: "form-label" %>
                <%= form.password_field :password, class: "form-control", placeholder: "Insira sua senha", required: true, name: "user[password]" %>
              </div>
              
              <div class="mb-3">
                <%= form.label :password_confirmation, "Confirmação de Senha", class: "form-label" %>
                <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Insira sua senha", required: true, name: "user[password_confirmation]"  %>
              </div>

              <% if @user.errors.any? %>
                <div class="alert alert-danger">
                  <ul>
                    <% @user.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              
              <div class="d-grid mb-3">
                <%= form.submit "Cadastrar", class: "btn btn-primary btn-block" %>
              </div>
            <% end %>

        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
