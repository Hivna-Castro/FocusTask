
  <body class="bg-gray-200 flex items-center justify-center min-h-screen">
    <div class="container mx-auto px-4">
      <div class="max-w-md mx-auto bg-white shadow-lg rounded-lg p-6">
          
          <div class="text-center mb-6">
            <h1 class="text-4xl font-bold text-primary">Bem-vindo ao FocusTask!</h1>
            <p class="text-gray-600 mt-2">Gerenciando suas tarefas com eficiência.</p>
          </div>

          <div>
            <h1 class="text-2xl font-semibold text-gray-800 mb-4">Cadastro</h1>
            <%= form_with(url: signup_path, local: true) do |form| %>
              <div class="mb-4">
                <%= form.label :name, "Name", class: "form-label", class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "Insira seu nome", required: true, name: "user[name]" %>
              </div>
              
              <div class="mb-4">
                <%= form.label :email, "Email", class: "form-label" %>
                <%= form.email_field :email, class: "form-control", placeholder: "Insira seu email", required: true, name: "user[email]" %>
              </div>
              
              <div class="mb-4">
                <%= form.label :password, "Senha", class: "form-label" %>
                <%= form.password_field :password, class: "form-control", placeholder: "Insira sua senha", required: true, name: "user[password]" %>
              </div>
              
              <div class="mb-4">
                <%= form.label :password_confirmation, "Confirmação de Senha", class: "form-label" %>
                <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Insira sua senha", required: true, name: "user[password_confirmation]"  %>
              </div>

              <% if @user.errors.any? %>
                <div class="alert alert-danger">
                  <ul>
                    <% @user.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              
              <div class="mb-6">
                <%= form.submit "Cadastrar", class:"w-full bg-primary text-white py-2 px-4 rounded-md hover:bg-primary_hover focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"%>
              </div>
            <% end %>

        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
