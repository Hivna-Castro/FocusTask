<body class="bg-gray-200 flex items-center justify-center min-h-screen">
  <div class="container mx-auto px-4">
    <div class="max-w-md mx-auto bg-white shadow-lg rounded-lg p-6">

      <div class="text-center mb-6">
        <h1 class="text-4xl font-bold text-primary">Bem-vindo ao FocusTask!</h1>
        <p class="text-gray-600 mt-2">Gerenciando suas tarefas com eficiência.</p>
      </div>

      <div>
        <h1 class="text-2xl font-semibold text-gray-800 mb-4">Login</h1>
        <%= form_with(url: login_path, local: true) do |form| %>
          <div class="mb-4">
            <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
            <%= form.email_field :email, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "Insira seu email", required: true %>
          </div>
          <div class="mb-4">
            <%= form.label :password, "Senha", class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "Insira sua senha", required: true %>
          </div>
          <div class="mb-6">
            <%= form.submit "Entrar", class: "w-full bg-primary text-white py-2 px-4 rounded-md hover:bg-primary_hover focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
          </div>
        <% end %>
        <p class="text-center text-sm text-gray-600">
          Não possui uma conta? 
          <%= link_to 'Cadastre-se', signup_path, class: "text-primary hover:underline" %>
        </p>
      </div>
    </div>
  </div>
</body>
