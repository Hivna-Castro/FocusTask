 <body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 bg-white shadow rounded d-flex overflow-hidden">
          
          <!--  boas-vindas -->
          <div class="col-md-6 d-flex flex-column justify-content-center align-items-start p-5 text-white bg-primary">
            <h2 class="fw-bold">FocusTask</h2>
            <p class="lead">Gerenciando suas tarefas com eficiência.</p>
          </div>

          <!-- login -->
          <div class="col-md-6 p-5">
            <h1 class="h4 mb-4 fw-normal text-center">Login</h1>
            <%= form_with(url: login_path, local: true, class: "mt-3") do |form| %>
              <div class="mb-3">
                <%= form.label :email, "Email", class: "form-label" %>
                <%= form.email_field :email, class: "form-control", placeholder: "Insira seu email", required: true %>
              </div>
              <div class="mb-3">
                <%= form.label :password, "Senha", class: "form-label" %>
                <%= form.password_field :password, class: "form-control", placeholder: "Insira sua senha", required: true %>
              </div>
              <div class="d-grid mb-3">
                <%= form.submit "Entrar", class: "btn btn-primary btn-block" %>
              </div>
            <% end %>
            <p class="text-center">Não tem uma conta? <%= link_to 'Cadastre-se', signup_path %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS Bundle com Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>