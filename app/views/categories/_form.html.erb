<h1><%= @category.persisted? ? "Editar Categoria" : "Nova Categoria" %></h1>

<%= form_with model: @category, local: true do |form| %>
  <div class="mb-3">
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Descrição" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :color, "Cor da Categoria" %>
    <%= form.color_field :color, class: "form-control", value: @category.color %>
  </div>

  <%= form.submit @category.persisted? ? "Atualizar Categoria" : "Adicionar Categoria", class: "btn btn-primary" %>
<% end %>