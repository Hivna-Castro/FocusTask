<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
   <%= stylesheet_link_tag 'main.css' %>
</head>

<body class="bg-light" style="min-height: 100vh;">
  <div class="container-fluid">
    <div class="row align-items-center mb-4 position-fixed top-0 w-100 bg-light shadow-sm p-3" style="z-index: 1030;">
      <div class="col-md-6">
        <h2 class="fw-bold text-primary">FocusTask</h2>
      </div>
      <div class="col-md-6 text-end">
        <%= link_to 'Adicionar Categoria', new_category_path, class: 'btn btn-primary' %>
        <%= link_to 'Tarefas', tasks_path, class: 'btn btn-primary' %>
        <%= link_to 'Sair', logout_path, data: { confirm: "Tem certeza que quer sair?" }, class: 'btn btn-outline-secondary me-2' %>
      </div>
    </div>

    <div style="height: 100px;"></div>

    <div class="row mt-4 justify-content-center">
      <% if @categories.any? %>
        <% @categories.each do |category| %>
          <div class="col-12 col-sm-6 col-lg-4 mb-4 d-flex align-items-stretch">
            <div class="card shadow-sm w-100 task-card" style="cursor: pointer; border-color: <%= category.color.presence || '#ffffff' %>;">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= category.name %></h5>
                <p class="card-text text-truncate" style="max-height: 3.5em;"><%= category.description %></p>
                
                <div class="d-flex justify-content-between mt-auto">
                  <%= link_to 'Editar', edit_category_path(category), class: 'btn btn-primary' %>
                  <%= form_with url: category_path(category), method: :delete, data: { confirm: "Tem certeza?" }, class: 'd-inline' do |form| %>
                      <%= form.submit 'Excluir', class: 'btn btn-danger' %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-muted">Nenhuma categoria encontrada.</p>
      <% end %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>